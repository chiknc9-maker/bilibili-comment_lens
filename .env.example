# 复制本文件为 .env 并填入自己的凭据。.env 已被 .gitignore，不会泄露。

# ── B站抓取 cookie（可选，匿名也能抓，登录态更稳）──
# 获取：浏览器登录 bilibili.com → F12 → Network → 刷新 → 任意 api.bilibili.com
# 请求 → Request Headers → Cookie 里的 SESSDATA=... 和 buvid3=...
SESSDATA=
BUVID3=

# ── DeepSeek API（M1 分析管线必需）──
# 申请：https://platform.deepseek.com → 登录 → API Keys → 创建 key（先充值少量）
# 官方兼容 OpenAI 协议，key 以 sk- 开头
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
